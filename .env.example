# This file is the DEVELOPER template. `composer setup` copies it verbatim, so the two values
# below are the ones a shared environment must not inherit:
#
#   APP_ENV=local   enables the demo seeders (DatabaseSeeder seeds DemoDataSeeder and the 100
#                   LocalProcessSeeder journeys only when the environment is local)
#   APP_DEBUG=true  serves stack traces, including connection details, on any error
#
# For UAT or staging run `composer setup:uat`, which writes APP_ENV=staging and APP_DEBUG=false
# and seeds reference data and users only. See "Provisioning UAT" in README.md.
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Anything other than `sync` needs a worker running (`php artisan queue:work`), or queued
# work is written and never executed. Notifications are queued, so with no worker the
# in-app inbox stays silently empty — no error, no log line. `php artisan queue:health`
# reports whether one is draining the queue, and exits non-zero when nothing is.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
